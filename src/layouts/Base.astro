---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
const {
  title = 'Free Power, Battery, Inverter & Solar Calculators',
  description = 'Free, transparent power and energy calculators for batteries, inverters, UPS, solar, appliances and generators.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://powercalc-hub.vercel.app');
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><meta name="theme-color" content="#101b2d" /><title>{title} | PowerCalc Hub</title><meta
      name="description"
      content={description}
    /><link rel="canonical" href={canonical.toString()} />{
      (import.meta.env.VERCEL_ENV !== 'production' || !import.meta.env.PUBLIC_SITE_URL) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }<meta name="twitter:card" content="summary" /><meta
      name="twitter:title"
      content={`${title} | PowerCalc Hub`}
    /><meta name="twitter:description" content={description} /><meta
      property="og:type"
      content="website"
    /><meta property="og:title" content={`${title} | PowerCalc Hub`} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical.toString()} /><script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'PowerCalc Hub',
        url: new URL('/', canonical).toString(),
      })}
    /><script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('theme') || 'light';
      } catch {}
    </script><Analytics /></head
  >
  <body
    ><header class="top">
      <div class="wrap nav">
        <a class="logo" href="/"><span class="logoicon">⚡</span> PowerCalc <b>Hub</b></a><nav
          aria-label="Main navigation"
        >
          <a href="/#calculators">Calculators</a><a href="/about">About</a><button
            id="theme"
            aria-label="Toggle dark mode"
            type="button">◐ <span>Theme</span></button
          >
        </nav>
      </div>
    </header><main class="wrap"><slot /></main><footer>
      <div class="wrap">
        <p><strong>PowerCalc Hub</strong> · Independent, free electrical planning tools.</p><p>
          Calculator results are estimates. Actual electrical performance depends on equipment
          specifications, condition, temperature, installation, battery age, wiring, power factor
          and other factors. Verify equipment sizing with a qualified electrician or installer.
        </p><p>
          <a href="/about">About & methodology</a> · <a href="/privacy">Privacy</a> · <a
            href="/#calculators">All calculators</a
          >
        </p>
      </div>
    </footer><script is:inline>
      document.querySelector('#theme')?.addEventListener('click', () => {
        const t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
        try {
          localStorage.setItem('theme', t);
        } catch {}
      });
    </script></body
  >
</html>
<style is:global>
  :root {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      'Segoe UI',
      sans-serif;
    color: #18283f;
    background: #f5f8fc;
    font-synthesis: none;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    line-height: 1.55;
  }
  a {
    color: #1265bc;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  button,
  input,
  select {
    font: inherit;
  }
  button {
    cursor: pointer;
  }
  .wrap {
    max-width: 1120px;
    margin: auto;
    padding: 0 20px;
  }
  .top {
    background: #fff;
    border-bottom: 1px solid #e2e9f2;
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 72px;
  }
  .logo {
    font-size: 1.25rem;
    font-weight: 800;
    color: #142c4b;
    white-space: nowrap;
  }
  .logo b {
    color: #188a7b;
  }
  .logoicon {
    background: #e0f7ee;
    padding: 7px;
    border-radius: 12px;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .nav button {
    border: 1px solid #d9e3ec;
    background: transparent;
    border-radius: 10px;
    padding: 7px 12px;
    color: inherit;
  }
  .hero {
    padding: 65px 0 30px;
  }
  .eyebrow {
    color: #008b76;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.76rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1.13;
    margin: 12px 0;
  }
  h2 {
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
  }
  h3 {
    font-size: 1.05rem;
    margin: 0 0 10px;
  }
  p {
    margin: 10px 0 18px;
  }
  .muted {
    color: #607086;
  }
  .section {
    margin: 38px 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .card,
  .panel {
    background: #fff;
    border: 1px solid #e1e8f1;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 8px 24px #1a3a5d08;
  }
  .card {
    display: block;
    color: inherit;
    transition:
      transform 0.15s,
      border-color 0.15s;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: #80b7df;
    text-decoration: none;
  }
  .pill {
    font-size: 0.76rem;
    color: #00816d;
    font-weight: 700;
  }
  .card p {
    font-size: 0.9rem;
    color: #607086;
    margin: 8px 0 0;
  }
  .ad {
    min-height: 100px;
    border: 1px dashed #b9c6d4;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7a8b9c;
    font-size: 0.75rem;
    margin: 24px 0;
    background: linear-gradient(110deg, #f7f9fc, #edf2f8);
  }
  .crumb {
    font-size: 0.84rem;
    color: #607086;
    margin: 28px 0;
  }
  .toolhead {
    max-width: 850px;
  }
  .calcgrid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
    gap: 20px;
    align-items: start;
  }
  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .field label {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .field input,
  .field select,
  .search {
    display: block;
    width: 100%;
    border: 1px solid #c9d5e2;
    border-radius: 11px;
    padding: 12px;
    background: transparent;
    color: inherit;
    min-height: 46px;
  }
  .field small {
    color: #64748b;
  }
  .field input:focus,
  .search:focus,
  button:focus-visible,
  a:focus-visible {
    outline: 3px solid #4eaccd;
    outline-offset: 2px;
  }
  .primary {
    border: 0;
    background: #087e70;
    color: white;
    padding: 13px 22px;
    border-radius: 11px;
    font-weight: 800;
    margin-top: 18px;
  }
  .result {
    background: linear-gradient(145deg, #123b59, #102b42);
    color: white;
    border-radius: 18px;
    padding: 26px;
    min-height: 240px;
  }
  .result .big {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 850;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .result small {
    color: #b8d6e5;
  }
  .result p {
    color: #d3e5ed;
  }
  .note {
    border-left: 3px solid #0a9585;
    padding: 12px 16px;
    background: #eaf7f3;
    border-radius: 6px;
  }
  .info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .info section {
    background: #fff;
    border: 1px solid #e1e8f1;
    padding: 20px;
    border-radius: 16px;
  }
  .info ul {
    padding-left: 20px;
  }
  .presetrow {
    display: grid;
    grid-template-columns: 1fr 90px 80px;
    gap: 8px;
    align-items: center;
    margin: 8px 0;
  }
  .presetrow input {
    min-width: 0;
    width: 100%;
    border: 1px solid #c9d5e2;
    padding: 9px;
    border-radius: 8px;
    background: transparent;
    color: inherit;
  }
  .presetrow label {
    font-size: 0.86rem;
  }
  footer {
    margin-top: 70px;
    padding: 35px 0;
    background: #eaf0f6;
    color: #54677e;
    font-size: 0.85rem;
  }
  footer p {
    max-width: 950px;
  }
  html[data-theme='dark'] {
    color: #e7edf5;
    background: #0c1727;
  }
  html[data-theme='dark'] .top,
  html[data-theme='dark'] .card,
  html[data-theme='dark'] .panel,
  html[data-theme='dark'] .info section {
    background: #15263b;
    border-color: #294058;
  }
  html[data-theme='dark'] .logo {
    color: #e7edf5;
  }
  html[data-theme='dark'] .muted,
  html[data-theme='dark'] .card p {
    color: #a7b8ca;
  }
  html[data-theme='dark'] .ad {
    background: #172a40;
    border-color: #38516b;
  }
  html[data-theme='dark'] footer {
    background: #132237;
    color: #adbdcf;
  }
  html[data-theme='dark'] .note {
    background: #163c38;
    color: #d7f6ef;
  }
  html[data-theme='dark'] input {
    color-scheme: dark;
  }
  html[data-theme='dark'] select {
    color-scheme: dark;
  }
  @media (max-width: 780px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .calcgrid,
    .info {
      grid-template-columns: 1fr;
    }
    .hero {
      padding: 40px 0 20px;
    }
  }
  [hidden] {
    display: none !important;
  }
  select:focus-visible {
    outline: 3px solid #4eaccd;
    outline-offset: 2px;
  }
  @media (max-width: 490px) {
    .nav {
      flex-wrap: wrap;
      padding-top: 12px;
      padding-bottom: 12px;
    }
    .nav nav {
      width: 100%;
      justify-content: space-between;
    }
    .wrap {
      padding: 0 15px;
    }
    .grid,
    .fields {
      grid-template-columns: 1fr;
    }
    .nav nav {
      gap: 10px;
    }
    .nav nav a {
      font-size: 0.83rem;
    }
    .nav button span {
      display: none;
    }
    .logo {
      font-size: 1rem;
    }
    .card,
    .panel {
      padding: 17px;
    }
    .presetrow {
      grid-template-columns: 1fr 70px 65px;
    }
    .hero {
      padding-top: 30px;
    }
  }

  /* Dimensional surfaces: CSS only, with motion limited to pointer interactions. */
  :root {
    --depth-surface: #fff;
    --depth-edge: #d5e1e9;
    --depth-line: #e2eaf0;
    --depth-shadow: #213f5e14;
    --depth-glow: #159b8220;
  }
  body {
    background:
      radial-gradient(ellipse at 85% 8%, #d8f4eb80, transparent 38%),
      radial-gradient(ellipse at 0% 35%, #e1eaf580, transparent 45%);
  }
  .top {
    background: #fffffff2;
    box-shadow: 0 4px 20px #23445c08;
    backdrop-filter: blur(14px);
  }
  .logoicon {
    display: inline-block;
    box-shadow:
      inset 0 1px 0 #fff,
      0 3px 0 #bfdfd3,
      0 5px 10px #0a665018;
    transform: rotate(-5deg);
  }
  .hero-depth {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
    gap: 30px;
    padding: 64px 0 38px;
  }
  .hero-copy {
    min-width: 0;
    position: relative;
    z-index: 1;
  }
  .hero-depth h1 {
    font-size: clamp(2.2rem, 4.3vw, 3.5rem);
    text-shadow: 0 3px 0 #ffffffb0;
  }
  .hero-depth .eyebrow {
    display: inline-block;
    padding: 7px 12px;
    border: 1px solid #cce8df;
    border-radius: 99px;
    background: #effbf6;
    box-shadow: 0 2px 0 #d4e9e1;
  }
  .hero-depth .muted {
    max-width: 540px;
  }
  .hero-depth label {
    display: block;
    margin: 24px 0 8px;
    font-size: 0.86rem;
    font-weight: 650;
  }
  .energy-scene {
    position: relative;
    height: 340px;
    min-width: 0;
    perspective: 900px;
    isolation: isolate;
  }
  .scene-halo {
    position: absolute;
    inset: 12px 0 0;
    border-radius: 50%;
    background: radial-gradient(ellipse, #8de6cb55 0%, #c8e5f530 50%, transparent 70%);
  }
  .scene-orbit {
    position: absolute;
    width: 88%;
    height: 155px;
    left: 6%;
    bottom: 12px;
    border: 1px solid #a6d4c5;
    border-radius: 50%;
    transform: rotate(-12deg);
    box-shadow: 0 16px 40px #22745c0c;
  }
  .scene-orbit::after {
    content: '';
    position: absolute;
    inset: 16px;
    border: 1px dashed #abc9d6;
    border-radius: inherit;
  }
  .energy-platform {
    position: absolute;
    left: 19%;
    bottom: 62px;
    width: 64%;
    height: 128px;
    border-radius: 30px;
    background: linear-gradient(130deg, #fff, #d9e6ee);
    transform: rotateX(56deg) rotateZ(-27deg);
    box-shadow:
      0 9px 0 #bdd0db,
      0 14px 0 #a8c1cc,
      0 35px 30px #264a6633;
    border: 1px solid #fff;
  }
  .energy-battery {
    position: absolute;
    left: 36%;
    top: 67px;
    width: 128px;
    height: 178px;
    border-radius: 24px;
    transform: rotate(-9deg) skewY(5deg);
    background: linear-gradient(120deg, #31c5a0, #0a8d76 65%, #076958);
    border: 2px solid #6cddbb;
    box-shadow:
      inset 5px 3px 5px #bbffe64d,
      inset -9px -5px 12px #03523d55,
      11px 8px 0 #075f54,
      15px 12px 0 #084e49,
      17px 27px 28px #0c524a35;
  }
  .energy-battery::before {
    content: '';
    position: absolute;
    width: 46px;
    height: 17px;
    top: -17px;
    left: 37px;
    border: 1px solid #d0f1e5;
    border-radius: 7px 7px 0 0;
    background: linear-gradient(120deg, #d1efe3, #84ad9e);
    box-shadow: 7px 2px 0 #608f80;
  }
  .energy-bolt {
    display: block;
    font-size: 76px;
    line-height: 1;
    text-align: center;
    margin-top: 34px;
    color: #e7fff4;
    text-shadow: 0 4px 0 #075c4c55;
  }
  .energy-bars {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin-top: 18px;
  }
  .energy-bars i {
    width: 15px;
    height: 7px;
    background: #a1f6d6;
    border-radius: 2px;
    box-shadow: 0 2px 0 #076956;
  }
  .energy-sun {
    position: absolute;
    top: 28px;
    right: 10%;
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ffeaae, #efba4c);
    border: 5px solid #fff5d1;
    box-shadow:
      5px 6px 0 #d39e39,
      0 0 0 12px #f8d77a22,
      0 10px 25px #ba862e20;
  }
  .energy-panel {
    position: absolute;
    left: 4%;
    bottom: 59px;
    width: 107px;
    height: 85px;
    border: 6px solid #dce7f0;
    border-radius: 10px;
    background-color: #285d8d;
    background-image:
      linear-gradient(#84b3db66 1px, transparent 1px),
      linear-gradient(90deg, #84b3db66 1px, transparent 1px),
      linear-gradient(130deg, #477faf55, transparent);
    background-size:
      100% 19px,
      24px 100%,
      100%;
    transform: rotate(-15deg) skewY(8deg);
    box-shadow:
      4px 6px 0 #829fb5,
      9px 16px 22px #23476425;
  }
  .energy-spark {
    position: absolute;
    right: 2%;
    bottom: 73px;
    padding: 11px 15px;
    font-size: 1.5rem;
    color: #138775;
    background: linear-gradient(135deg, #fff, #e2f3ee);
    border: 1px solid #fff;
    border-radius: 17px;
    transform: rotate(9deg);
    box-shadow:
      0 5px 0 #c5ddd5,
      0 13px 22px #225b4e18;
  }
  .scene-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.19em;
    color: #517f78;
    font-size: 0.63rem;
    font-weight: 750;
  }
  .card,
  .panel,
  .info section {
    background: linear-gradient(
      145deg,
      var(--depth-surface),
      color-mix(in srgb, var(--depth-surface), #b5d1e0 6%)
    );
    border-color: var(--depth-line);
    box-shadow:
      inset 0 1px 0 #ffffffa0,
      0 4px 0 var(--depth-edge),
      0 10px 22px var(--depth-shadow);
  }
  .card {
    position: relative;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }
  .tool-icon {
    display: inline-grid;
    place-items: center;
    vertical-align: middle;
    width: 37px;
    height: 37px;
    border: 1px solid #d6eee4;
    border-radius: 11px;
    background: linear-gradient(140deg, #effdf6, #d9f2e7);
    color: #087e70;
    font-size: 1.35rem;
    margin-right: 10px;
    box-shadow:
      inset 0 1px 0 #fff,
      0 3px 0 #c1ddd1;
  }
  .card .pill {
    display: inline;
  }
  .card h3 {
    line-height: 1.4;
  }
  .search,
  .field input,
  .field select,
  .presetrow input {
    background: #f1f6fa;
    box-shadow:
      inset 0 2px 4px #1d3c5910,
      0 1px 0 #fff;
    border-color: #bdcdd9;
  }
  .primary {
    background: linear-gradient(155deg, #159580, #087665);
    box-shadow:
      inset 0 1px 0 #71c9b780,
      0 4px 0 #07594e,
      0 9px 15px #0b76532b;
    transition:
      transform 150ms ease,
      box-shadow 150ms ease;
  }
  .primary:active {
    transform: translateY(3px);
    box-shadow:
      inset 0 1px 0 #71c9b780,
      0 1px 0 #07594e;
  }
  .nav button {
    background: linear-gradient(145deg, #fff, #edf3f8);
    box-shadow:
      inset 0 1px 0 #fff,
      0 3px 0 #d4e0e8,
      0 5px 10px #193c5210;
  }
  .result {
    position: relative;
    border: 1px solid #42758c;
    background:
      radial-gradient(ellipse at top right, #20727b, transparent 70%),
      linear-gradient(145deg, #153e57, #102b42);
    box-shadow:
      inset 0 1px 0 #8fbac54d,
      0 5px 0 #0b2133,
      0 16px 25px #153f5b24;
  }
  .result .big {
    text-shadow: 0 3px 0 #001b2f50;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-5px) rotateX(1deg);
      border-color: #85bcae;
      box-shadow:
        inset 0 1px 0 #fff,
        0 7px 0 var(--depth-edge),
        0 20px 28px var(--depth-shadow),
        0 0 0 3px var(--depth-glow);
    }
    .primary:hover {
      transform: translateY(-1px);
    }
  }
  html[data-theme='dark'] {
    --depth-surface: #152b40;
    --depth-edge: #091722;
    --depth-line: #304c60;
    --depth-shadow: #00000033;
    --depth-glow: #51c5ac15;
  }
  html[data-theme='dark'] body {
    background: radial-gradient(ellipse at 85% 8%, #0e5d4d40, transparent 42%);
  }
  html[data-theme='dark'] .top {
    background: #112235f2;
  }
  html[data-theme='dark'] .card,
  html[data-theme='dark'] .panel,
  html[data-theme='dark'] .info section {
    background: linear-gradient(145deg, #1a3349, #14273b);
    box-shadow:
      inset 0 1px 0 #42607455,
      0 4px 0 var(--depth-edge),
      0 10px 24px var(--depth-shadow);
  }
  html[data-theme='dark'] .hero-depth h1 {
    text-shadow: 0 3px 0 #00000055;
  }
  html[data-theme='dark'] .hero-depth h1 span {
    color: #60d9ba !important;
  }
  html[data-theme='dark'] .eyebrow {
    color: #83dec9;
    background: #143c36;
    border-color: #2a5e51;
    box-shadow: 0 2px 0 #071b1a;
  }
  html[data-theme='dark'] .pill {
    color: #82dbc0;
  }
  html[data-theme='dark'] .tool-icon {
    background: linear-gradient(145deg, #205247, #173e39);
    color: #a6ecd5;
    border-color: #34675b;
    box-shadow:
      inset 0 1px 0 #5e8b7540,
      0 3px 0 #0c201f;
  }
  html[data-theme='dark'] .search,
  html[data-theme='dark'] .field input,
  html[data-theme='dark'] .field select,
  html[data-theme='dark'] .presetrow input {
    background: #0f2032;
    border-color: #34516a;
